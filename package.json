{
  "name": "httpbin",
  "private": true,
  "version": "0.1.4",
  "description": "A public webhook inspector with configurable responses and real-time event monitoring.",
  "license": "MIT",
  "repository": "github:mauriziocarella/httpbin",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.12",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "tsx": "^4.20.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
